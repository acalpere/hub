# Sense ACALPERE_DATABASE_URL es fa servir SQLite (acalpere.db). Per a Neon, la cadena amb pooler;
# per a les migracions, la directa (ACALPERE_DATABASE_URL_UNPOOLED).
# ACALPERE_DATABASE_URL=postgresql://usuari:clau@host/acalpere?sslmode=require
# ACALPERE_DATABASE_URL_UNPOOLED=postgresql://usuari:clau@host-directe/acalpere?sslmode=require
ACALPERE_SECRET_KEY=canvia-aixo-en-local
ACALPERE_ENV=local
ACALPERE_CORS_ORIGINS=http://localhost:5173
